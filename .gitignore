# Secrets — never committed
.env
.env.*
!.env.example

# Pulled account data (private business data, regenerable via engine/fetch_meta.py)
data/meta/*
data/site/*
!data/meta/.gitkeep
!data/site/.gitkeep

# Raw fetched evidence can be large; committed selectively
signals/sources/raw/

__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
