# Secrets — never committed
.env
.env.*
!.env.example

# data/meta/ is committed (see CLAUDE.md — cloud sessions can't reach the Meta
# API, so the repo carries the data). Site data remains local-only.
data/site/*
!data/site/.gitkeep

# Raw fetched evidence can be large; committed selectively
signals/sources/raw/

__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
