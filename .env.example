# Copy to .env and fill in. NEVER commit .env.
#
# Access token: lift from the magic-portraits-ads skill's fetch_ads.py on the
# local machine (Phase 0 brief §9). For unattended scheduled runs, upgrade to a
# non-expiring system-user token scoped read-only to ads_read.
META_ACCESS_TOKEN=

# Magic Portraits ad account. Verified 2026-07-02 via Meta MCP recon:
# business "Magic Portraits" (2360160461089208) owns ad account 852673303845594
# ("Magic Pets", USD, active). The act_ prefix is added automatically if omitted.
META_AD_ACCOUNT_ID=act_852673303845594

# Graph API version (override if the default is deprecated)
META_API_VERSION=v23.0
